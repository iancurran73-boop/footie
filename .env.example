# .env.example
# ─────────────
# Copy to .env and fill in your values. NEVER commit .env to version control.

# ── Resend (required for ticket confirmation / winner emails) ─────────────────
# Get a key at resend.com after verifying a sending domain. The From address
# set in Admin > Emails must be on that verified domain.
# RESEND_API_KEY=re_your_key_here

# SumUp (raffle ticket payments) and Facebook Page (social posting) are
# configured from the admin UI (Payments / Social tabs), not here — their
# credentials are stored in the database.
